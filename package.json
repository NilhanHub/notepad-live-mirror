{
  "name": "notepad-live-mirror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "tsc -p backend/tsconfig.json && vite build --config vite.config.ts",
    "start": "node backend/dist/server.js",
    "sync:oracle": "tsx backend/src/cli/syncOracleSurface.ts",
    "test": "vitest run",
    "inspect:notepad": "tsx backend/src/cli/inspectNotepad.ts",
    "inspect:tree": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/inspect-notepad-tree.ps1",
    "smoke:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-live.ps1",
    "audit:real": "tsx backend/src/cli/realUserAudit.ts",
    "create:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "verify:headless": "npm run build && playwright test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  }
}
